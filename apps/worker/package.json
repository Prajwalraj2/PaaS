{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "PaaS Build Worker - Processes build and deployment jobs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}



